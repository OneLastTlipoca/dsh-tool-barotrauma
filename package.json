{
  "name": "dsh-tool-barotrauma",
  "version": "0.5.0",
  "description": "DeepSeek Harness 潜渊症（Barotrauma）mod 制作工具集：内容包骨架、物品/武器/角色/事件 XML 生成、Lua 与 C# 内存脚本脚手架、本地化、校验与创意工坊打包发布。零外部 MCP 依赖。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "INSTALL.md",
    "功能说明.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "tool",
    "barotrauma",
    "luacs",
    "modding",
    "content-package",
    "steam-workshop"
  ],
  "license": "MIT",
  "author": "OneLastTlipoca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneLastTlipoca/dsh-tool-barotrauma.git"
  },
  "homepage": "https://github.com/OneLastTlipoca/dsh-tool-barotrauma#readme",
  "bugs": {
    "url": "https://github.com/OneLastTlipoca/dsh-tool-barotrauma/issues"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
